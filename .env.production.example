# روی سرور کپی کن: cp .env.production.example .env
# فعلاً دامنه نداریم؛ سرویس مستقیم روی این پورت هاست باز می‌شود (بدون Caddy).
HUB_HOST_PORT=4500
# بعداً که دامنه گرفتیم، این را به همان ساب‌دومین ست کن و سرویس را پشت Caddy مشترک khodroban می‌بریم.
HUB_DOMAIN=localhost

# gateway هوش مصنوعی برای نوشتن محتوا (جایگزین Claude Code CLI/agent خارجی). توکن واقعی را
# فقط همین‌جا روی سرور بگذار؛ هرگز در گیت یا چت کپی نشود.
AI_GATEWAY_URL=http://194.146.123.114:51091/v1/chat
AI_GATEWAY_TOKEN=
AI_GATEWAY_MODEL=haiku
